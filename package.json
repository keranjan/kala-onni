{
  "name": "kala-onni",
  "version": "1.0.0",
  "description": "Paikkatietopohjainen kalastuskartta: lähialueen kalapaikat, kalalajit ja kalasääennuste parhaine kalastusaikoineen.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "python3 -m http.server 5173",
