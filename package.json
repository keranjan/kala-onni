    "smoke": "node test/smoke.mjs"
  },
  "keywords": [
    "kalastus",
    "kartta",
    "sää",
    "leaflet",
    "openstreetmap"
  ],
  "license": "MIT",
  "devDependencies": {
    "leaflet": "^1.9.4",
    "playwright": "^1.63.0"
  }
}
